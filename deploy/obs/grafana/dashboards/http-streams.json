{
  "uid": "td-http-streams",
  "title": "Trend Detective: HTTP streams",
  "description": "Open streams and request health on the gateway and narrator. WatchJob and Narrate are long-lived streams and are shown apart from unary calls.",
  "tags": [
    "trend-detective"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(watchers_http_operations_in_flight{job=\"trend-detective\"}, service)",
        "query": {
          "query": "label_values(watchers_http_operations_in_flight{job=\"trend-detective\"}, service)",
          "refId": "service"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "links": [
    {
      "title": "Trend Detective",
      "type": "dashboards",
      "tags": [
        "trend-detective"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Open streams",
      "description": "WatchJob and Narrate streams open right now. Goes up as soon as a stream opens; the counters below only move when it closes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, operation) (watchers_http_operations_in_flight{job=\"trend-detective\",service=~\"$service\",operation=~\".*/(WatchJob|Narrate)\"})",
          "legendFormat": "{{service}} {{operation}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Unary calls in flight",
      "description": "Unary requests being handled right now.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, operation) (watchers_http_operations_in_flight{job=\"trend-detective\",service=~\"$service\",operation!~\".*/(WatchJob|Narrate)\"})",
          "legendFormat": "{{service}} {{operation}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Completed calls since start",
      "description": "Calls that finished since each process started, by procedure. A stream counts once, when it closes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, operation) (watchers_http_operations_total{job=\"trend-detective\",service=~\"$service\"})",
          "legendFormat": "{{service}} {{operation}}",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Mean stream duration since start",
      "description": "Average time a WatchJob or Narrate stream stayed open, since each process started. From the exact sum, so not capped by the 10 s top bucket.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, operation) (watchers_http_operation_duration_seconds_sum{job=\"trend-detective\",service=~\"$service\",operation=~\".*/(WatchJob|Narrate)\"}) / sum by (service, operation) (watchers_http_operation_duration_seconds_count{job=\"trend-detective\",service=~\"$service\",operation=~\".*/(WatchJob|Narrate)\"})",
          "legendFormat": "{{service}} {{operation}}",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "5xx share of completed calls",
      "description": "Share of calls that ended with HTTP 5xx, over the rate window. 4xx counts as success, and a stream that fails after its 200 response also looks successful. No data when nothing completed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (service, operation) (rate(watchers_http_operations_total{job=\"trend-detective\",service=~\"$service\",status=\"error\"}[$__rate_interval])) or on (service, operation) 0 * sum by (service, operation) (rate(watchers_http_operations_total{job=\"trend-detective\",service=~\"$service\"}[$__rate_interval]))) / sum by (service, operation) (rate(watchers_http_operations_total{job=\"trend-detective\",service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{operation}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Unary calls over 1 s",
      "description": "Share of completed unary calls that took longer than 1 s, over the rate window. Streams are left out because they are long by design. No data when nothing completed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - sum by (service, operation) (rate(watchers_http_operation_duration_seconds_bucket{job=\"trend-detective\",service=~\"$service\",operation!~\".*/(WatchJob|Narrate)\",le=~\"1(\\\\.0)?\"}[$__rate_interval])) / sum by (service, operation) (rate(watchers_http_operation_duration_seconds_count{job=\"trend-detective\",service=~\"$service\",operation!~\".*/(WatchJob|Narrate)\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{operation}}"
        }
      ]
    }
  ]
}
