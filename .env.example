# Settings for the local stack. `make up` copies this file to .env on the
# first run. Never commit .env.

# NASA Earthdata token. Get one at https://urs.earthdata.nasa.gov under
# Profile, Generate Token. Ingest needs it for Harmony and Giovanni.
EARTHDATA_TOKEN=

# SeaweedFS S3 credentials, local to your machine. Use letters and digits.
S3_ACCESS_KEY=trenddetective
S3_SECRET_KEY=localdevsecret
# The S3 address the browser uses. The gateway signs presigned URLs for this
# host, so it has to match what the browser actually requests.
S3_PUBLIC_ENDPOINT=http://localhost:8333
# Origins allowed to use presigned URLs from the browser.
S3_ALLOWED_ORIGINS=*
# How long presigned URLs work, and the largest CSV a user can upload.
PRESIGN_TTL=15m
MAX_UPLOAD_MB=20

# Origins allowed to call the gateway API from a browser, comma-separated.
CORS_ORIGINS=*

# Limits and defaults. The Configuration section of ARCHITECTURE.md explains
# each one.
TASK_CAP=256
HARMONY_CONCURRENCY=4
QUOTA_CUTOFF=0.9
MAX_GRANULES=1000
MAX_GRID=128
SUBREGION_N=8
