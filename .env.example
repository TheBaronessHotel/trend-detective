# Settings for the local stack. `make up` copies this file to .env on the
# first run. Never commit .env.

# NASA Earthdata token. Get one at https://urs.earthdata.nasa.gov under
# Profile, Generate Token. Ingest needs it for Harmony and Giovanni.
EARTHDATA_TOKEN=

# SeaweedFS S3 credentials, local to your machine. Use letters and digits.
S3_ACCESS_KEY=trenddetective
S3_SECRET_KEY=localdevsecret
# The S3 address the browser uses. The gateway signs presigned URLs for this
# host, so it has to match what the browser actually requests.
S3_PUBLIC_ENDPOINT=http://localhost:8333
# Origins allowed to use presigned URLs from the browser.
S3_ALLOWED_ORIGINS=*
# How long presigned URLs work, and the largest CSV a user can upload.
PRESIGN_TTL=15m
MAX_UPLOAD_MB=20

# Origins allowed to call the gateway API from a browser, comma-separated.
CORS_ORIGINS=*

# Limits and defaults. The Configuration section of ARCHITECTURE.md explains
# each one.
TASK_CAP=256
HARMONY_CONCURRENCY=4
QUOTA_CUTOFF=0.9
MAX_GRANULES=1000
MAX_GRID=128
SUBREGION_N=8

# For AppEEARS (MODIS plant greenness and ground temperature), which logs in
# with an Earthdata Login username and password instead of the token. Put the
# values in single quotes, so a $ in the password stays as it is.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Narrator. The user's LLM key arrives per request in the x-llm-api-key
# header and never goes in this file. Hosts that llm.base_url may point to,
# comma-separated (host, host:port or *.domain). Empty allows any host; set it
# before any public deploy, e.g. api.openai.com,api.anthropic.com,openrouter.ai
NARRATOR_LLM_BASE_URL_ALLOWLIST=
# How long one Narrate stream may run.
NARRATE_TIMEOUT=3m
# How long an LLM provider may take before its response headers. Thinking
# models can hold them back for minutes. Capped at NARRATE_TIMEOUT.
NARRATOR_LLM_HEADER_TIMEOUT=150s
# The gateway's bound for a Narrate call. Keep it longer than NARRATE_TIMEOUT,
# so the narrator's own timeout message reaches the browser.
NARRATOR_TIMEOUT=4m
# Optional outbound proxy for LLM calls, e.g. http://host.docker.internal:3128
# for a proxy on this machine. It must listen on the Docker bridge (0.0.0.0 or
# 172.17.0.1), not only on 127.0.0.1. NARRATOR_NO_PROXY defaults to the stack's
# services, localhost and host.docker.internal.
NARRATOR_HTTPS_PROXY=
NARRATOR_HTTP_PROXY=

# Observability. `make up-obs` sets this to http://jaeger:4318 for you. Leave
# it empty with plain `make up`: the Go services then export no spans. Set it
# only to send spans to another OTLP/HTTP collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
